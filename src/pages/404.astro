---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません" noindex>
  <div class="container-page py-20 text-center">
    <h1 class="section-title">ページが見つかりません</h1>
    <p class="mt-4 text-sm text-sumi/80">URLが変更されたか、削除された可能性があります。</p>
    <a href="/" class="mt-8 inline-block rounded-md bg-matsu-700 px-5 py-3 text-sm font-bold text-white hover:bg-matsu-600">トップページへ戻る</a>
  </div>
</BaseLayout>
