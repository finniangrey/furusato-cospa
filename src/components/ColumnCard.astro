---
import { type Column, COLUMN_CATEGORY_LABEL, columnPath, isoDate, jpDate } from '../lib/columns';

interface Props {
  column: Column;
}

const { column } = Astro.props;
const { title, description, publishedAt, category, tags } = column.data;
---

<article class="tile h-full gap-2 p-5">
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <span class="badge bg-matsu-50 text-matsu-700">{COLUMN_CATEGORY_LABEL[category]}</span>
    <time datetime={isoDate(publishedAt)} class="text-sumi/60">{jpDate(publishedAt)}</time>
  </div>
  <h3 class="font-display text-lg font-bold leading-snug text-matsu-900">
    <a href={columnPath(column.id)} class="after:absolute after:inset-0 hover:underline">{title}</a>
  </h3>
  <p class="line-clamp-3 text-sm leading-relaxed text-sumi/80">{description}</p>
  {
    tags.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-1.5 pt-1 text-[11px] text-sumi/60">
        {tags.map((t) => <li class="rounded-full bg-kinari px-2 py-0.5">#{t}</li>)}
      </ul>
    )
  }
</article>
