# このファイルを .env にコピーして値を設定する（.env は Git にコミットしない）
# GitHub Actions では、リポジトリの Settings > Secrets and variables > Actions に同じ名前で登録する。
# すべて未設定の間は、サンプルデータ（30件）を生成するフォールバックモードで動く。

# 楽天ウェブサービス（https://webservice.rakuten.co.jp/）
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=
# 新しい発行形式のアプリで必要な場合のみ
RAKUTEN_ACCESS_KEY=

# Yahoo!ショッピング 商品検索API（https://developer.yahoo.co.jp/）
YAHOO_CLIENT_ID=
# バリューコマース経由のアフィリエイトID（任意）
YAHOO_AFFILIATE_ID=

# サイトの本番 URL（Cloudflare Pages 側の環境変数に設定）。未設定なら https://furusato-cospa.pages.dev
# ローカルで試すときは、シェルの環境変数として渡す（例: SITE_URL=https://example.com npm run build）
SITE_URL=

# GA4 の測定 ID。空のままなら計測タグは出力されない（Cloudflare Pages 側の環境変数に設定）
PUBLIC_GA_ID=
